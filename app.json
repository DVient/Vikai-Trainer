{
  "expo": {
    "name": "Vikai Trainer",
    "slug": "vikai-trainer",
    "version": "1.0.0",
    "scheme": "vikai-trainer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "android": {
      "package": "com.kaivic.vikaitrainer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.kaivic.vikaitrainer"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#22C55E"
        }
      ]
    ]
  }
}
