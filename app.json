{
  "expo": {
    "name": "Vikai Trainer",
    "slug": "vikai-trainer",
    "version": "1.0.0",
    "scheme": "vikai-trainer",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.kaivic.vikaitrainer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.kaivic.vikaitrainer"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#22C55E" }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "355a5bbc-026b-495f-8164-39d868f056ca"
      }
    },
    "owner": "dvient",
    "updates": {
      "url": "https://u.expo.dev/355a5bbc-026b-495f-8164-39d868f056ca"
    }
  }
}
